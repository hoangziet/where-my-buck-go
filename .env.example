# Copy to .env for local development. Replace both credentials before deployment.
# The local PostgreSQL database retains its original internal name to preserve existing owner data.
DATABASE_URL=postgresql+psycopg://fingpt:local-only-change-me@localhost:55432/fingpt
AUTH_HMAC_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes
APP_ENV=development
# Used in later AI milestones; not needed for the current auth-only app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
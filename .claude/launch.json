{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "set -a; source .env; set +a; .venv/bin/flask --app where_my_buck_go.api.app:create_app run --port 5000"],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- -p $PORT"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
